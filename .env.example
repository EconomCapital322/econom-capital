POSTGRES_USER=irrbb_market
POSTGRES_PASSWORD=local-market-only
POSTGRES_DB=irrbb_moex
DATABASE__DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

DATABASE__MIN_POOL_SIZE=1
DATABASE__MAX_POOL_SIZE=5
DATABASE__CONNECT_TIMEOUT=10
DATABASE__ACQUIRE_TIMEOUT=10
DATABASE__COMMAND_TIMEOUT=30
DATABASE__CLOSE_TIMEOUT=10
LOGGING__LEVEL=INFO
APP__TITLE=IRRBB curves
APP__CORS_ORIGINS=[]
APP__MAX_REQUEST_BODY_BYTES=16384
CALCULATION__SPEC_FILE=/app/backend/examples/moex-excel-grid-spec.json
INTEGRATIONS__FETCH_FUNCTION=web.integrations.moex:fetch_rates
INTEGRATIONS__BASE_FUNCTION=web.calculations.base_curve:build_base_curve
INTEGRATIONS__STRESS_HTTP_URL=http://stress:8081/internal/v1/stress-curves
INTEGRATIONS__STRESS_HTTP_VERSION=demo-only-go-stress
INTEGRATIONS__STRESS_HTTP_TIMEOUT_SECONDS=10
INTEGRATIONS__STRESS_HTTP_MAX_RESPONSE_BYTES=8388608

WORKER__POLL_SECONDS=1
WORKER__LEASE_SECONDS=60
WORKER__HEARTBEAT_SECONDS=10
WORKER__STAGE_TIMEOUT_SECONDS=120
LOADER__MAX_ATTEMPTS=3
LOADER__BACKOFF_BASE_SECONDS=1
LOADER__BACKOFF_CAP_SECONDS=5
LOADER__REQUEST_TIMEOUT_SECONDS=20
AUTOMATION__ENABLED=true
AUTOMATION__RUN_AT=19:15:00
AUTOMATION__LOOKBACK_DAYS=7

STRESS_HTTP_ADDR=0.0.0.0:8081
STRESS_READ_HEADER_TIMEOUT=5s
STRESS_READ_TIMEOUT=10s
STRESS_WRITE_TIMEOUT=30s
STRESS_IDLE_TIMEOUT=60s
STRESS_SHUTDOWN_TIMEOUT=10s
STRESS_LOG_LEVEL=INFO
STRESS_LOG_FORMAT=text

VITE_API_MODE=api
VITE_API_BASE_URL=
API_PROXY_TARGET=http://api:8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
