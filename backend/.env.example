# Explicit database connection required. Never point tests at a user database.
DATABASE__DSN=postgresql://user:password@127.0.0.1:5432/curves
DATABASE__MIN_POOL_SIZE=1
DATABASE__MAX_POOL_SIZE=5
DATABASE__CONNECT_TIMEOUT=10
DATABASE__ACQUIRE_TIMEOUT=10
DATABASE__COMMAND_TIMEOUT=30
DATABASE__CLOSE_TIMEOUT=10
LOGGING__LEVEL=INFO
# Optional external file. Default: packaged resource, or backend/log-config.json in checkout.
# LOGGING__CONFIG_FILE=/absolute/path/log-config.json

# Optional API configuration. No loader or worker is launched by FastAPI.
APP__TITLE=IRRBB curves
APP__CORS_ORIGINS=[]
# Technical HTTP body limit in bytes; does not define calculation precision or grid.
APP__MAX_REQUEST_BODY_BYTES=16384
# Supply an agreed JSON specification (no production grid/version is built in).
# CALCULATION__SPEC_FILE=/absolute/path/agreed-calculation-spec.json

# Trusted import paths. MOEX and stress adapters are configured separately.
INTEGRATIONS__FETCH_FUNCTION=web.integrations.moex:fetch_rates
INTEGRATIONS__BASE_FUNCTION=web.calculations.base_curve:build_base_curve
# INTEGRATIONS__STRESS_FUNCTION=package.module:build_stress_curves

# Worker and loader settings are deliberately explicit, with no production defaults.
# WORKER__POLL_SECONDS=...
# WORKER__LEASE_SECONDS=...
# WORKER__HEARTBEAT_SECONDS=...
# WORKER__STAGE_TIMEOUT_SECONDS=...
# Local loader retry settings; adjust for deployment.
LOADER__MAX_ATTEMPTS=3
LOADER__BACKOFF_BASE_SECONDS=1
LOADER__BACKOFF_CAP_SECONDS=5
LOADER__REQUEST_TIMEOUT_SECONDS=20

# Existing Go stress endpoint; mutually exclusive with STRESS_FUNCTION.
# Pin the deployed implementation to the stress_version used by calculation specs.
# The current Go API does not attest its binary version or accept a version field.
# INTEGRATIONS__STRESS_HTTP_URL=http://127.0.0.1:8081/internal/v1/stress-curves
# INTEGRATIONS__STRESS_HTTP_VERSION=<agreed-version>
INTEGRATIONS__STRESS_HTTP_TIMEOUT_SECONDS=10
INTEGRATIONS__STRESS_HTTP_MAX_RESPONSE_BYTES=8388608

# Standalone Loader publishes rates; AUTOMATION__ENABLED enables the hybrid queue.
# Legacy LOADER__ENQUEUE_AUTOMATIC=true is rejected; remove it from old environments.
# Published MOEX yearyields are fetched for exactly the requested report date.

# Hybrid mode: date selection queues missing history; worker schedules fresh rates.
# Example local schedule in Europe/Moscow; adjust to the source publication time.
AUTOMATION__ENABLED=false
AUTOMATION__RUN_AT=19:15:00
AUTOMATION__LOOKBACK_DAYS=7
