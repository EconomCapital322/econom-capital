# Explicit database connection required. Never point tests at a user database.
DATABASE__DSN=postgresql://user:password@127.0.0.1:5432/curves
DATABASE__MIN_POOL_SIZE=1
DATABASE__MAX_POOL_SIZE=5
DATABASE__CONNECT_TIMEOUT=10
DATABASE__ACQUIRE_TIMEOUT=10
DATABASE__COMMAND_TIMEOUT=30
DATABASE__CLOSE_TIMEOUT=10
LOGGING__LEVEL=INFO
# Optional external file. Default: packaged resource, or backend/log-config.json in checkout.
# LOGGING__CONFIG_FILE=/absolute/path/log-config.json

# Optional API configuration. No loader or worker is launched by FastAPI.
APP__TITLE=IRRBB curves
APP__CORS_ORIGINS=[]
# Technical HTTP body limit in bytes; does not define calculation precision or grid.
APP__MAX_REQUEST_BODY_BYTES=16384
# Supply an agreed JSON specification (no production grid/version is built in).
# CALCULATION__SPEC_FILE=/absolute/path/agreed-calculation-spec.json

# Trusted import paths; leave unset until colleagues provide real implementations.
# INTEGRATIONS__FETCH_FUNCTION=package.module:fetch_validated_rates
# INTEGRATIONS__BASE_FUNCTION=package.module:build_base_curve
# INTEGRATIONS__STRESS_FUNCTION=package.module:build_stress_curves

# Worker and loader settings are deliberately explicit, with no production defaults.
# WORKER__POLL_SECONDS=...
# WORKER__LEASE_SECONDS=...
# WORKER__HEARTBEAT_SECONDS=...
# WORKER__STAGE_TIMEOUT_SECONDS=...
# LOADER__MAX_ATTEMPTS=...
# LOADER__BACKOFF_BASE_SECONDS=...
# LOADER__BACKOFF_CAP_SECONDS=...
# LOADER__REQUEST_TIMEOUT_SECONDS=...
