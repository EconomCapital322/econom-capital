# Values are read by the local server. Exported environment variables take precedence.
SPECTRUM_LLM_PROVIDER=disabled
SPECTRUM_LLM_ENABLED=true
SPECTRUM_ALLOW_EXTERNAL_LLM=false
# Optional operator-approved aggregate fields for confidential or imported datasets.
SPECTRUM_AI_BANK_FIELDS=
SPECTRUM_LLM_TIMEOUT=12
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
