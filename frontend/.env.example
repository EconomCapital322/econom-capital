# VITE_* are public client settings. Never store secrets here.
# api is the default; demo explicitly enables local Excel fixtures.
VITE_API_MODE=api
# Empty = same-origin /api/v1; Vite proxies /api to API_PROXY_TARGET (default: http://127.0.0.1:8000).
# For a separate origin, set e.g. http://127.0.0.1:8000 and configure backend CORS.
VITE_API_BASE_URL=
